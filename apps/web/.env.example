# apps/web — environment variables
# Subset of root .env.example relevant to the Next.js app.
# Copy to apps/web/.env.local and fill from `supabase status` (local) or your cloud Supabase project.

# Public Supabase URL + anon key — required by the browser SDK.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog public key — exposed to the browser for product analytics.
NEXT_PUBLIC_POSTHOG_KEY=

# Anthropic API key — server-side only, used by the AI route handlers.
ANTHROPIC_API_KEY=

# Round 8 prototype gating — enables /identify and /api/identify when "true".
NEXT_PUBLIC_PROTOTYPE_MODE=true
