# Supabase project connection (browser + server, safe to expose).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never prefix NEXT_PUBLIC_, never expose to the client,
# never set in PR preview environments. See src/server/service-role/README.md
# and ADR-INV-001 §D5.
SUPABASE_SERVICE_ROLE_KEY=

# Master Key Encryption Key for business_signing_keys envelope encryption
# (ADR-INV-003 §D4). Versioned (kek_id column stores which version encrypted a given key).
SIGNING_MASTER_KEK_V1=

# Shared secret for internal server-to-server calls (e.g. the PDF signing pipeline
# calling back to validate a document_id). Short-lived HMAC, not a session token.
INTERNAL_PIPELINE_SECRET=
