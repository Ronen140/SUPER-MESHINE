    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.30",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.5",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
