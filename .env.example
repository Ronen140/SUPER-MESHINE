# SUPER-MESHINE — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. See ADR-003 §Implementation Notes step 9.

# --- Database (Postgres / Supabase) ---
# Pooled connection (used by the app at runtime; pgBouncer / Supavisor URL).
DATABASE_URL=
# Direct connection (used by drizzle-kit migrations only; bypasses the pooler).
DIRECT_URL=

# --- Supabase Auth + Storage ---
# Public Supabase project URL — exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — exposed to the browser; safe with RLS enforced.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude API for Process Agents / Customization Agent / Copilot) ---
ANTHROPIC_API_KEY=

# --- Observability ---
# Sentry DSN for error tracking (server + client).
SENTRY_DSN=
# PostHog public key for product analytics — exposed to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# Axiom token for log shipping (server-side).
AXIOM_TOKEN=

# --- Round 8 prototype gating ---
# When "true", prototype routes (currently /identify, /api/identify) are enabled.
# Production should set this to "false" or unset.
NEXT_PUBLIC_PROTOTYPE_MODE=true
